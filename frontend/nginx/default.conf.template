# Rendered by the nginx image at start-up (envsubst). ${PORT} comes from the environment:
# Cloud Run sets it (we deploy with --port 3000), docker compose uses the image default 3000.
#
# The /api and /health reverse proxy lives in /etc/nginx/snippets/api-proxy.conf, which
# docker-entrypoint.d/40-api-proxy.sh writes ONLY when BACKEND_URL is set:
#   - docker compose (assignment 3): BACKEND_URL=http://backend:8000 -> nginx proxies /api;
#   - Cloud Run (assignment 4): BACKEND_URL is empty -> no proxy. The load balancer's URL map
#     sends /api/* and /health straight to the backend service, and there is no host "backend".
# (A wildcard include that matches no file is not an error in nginx.)

# HSTS only for requests that reached the load balancer over HTTPS. Locally (http://localhost)
# the header must not be sent.
map $http_x_forwarded_proto $hsts_header {
    https   "max-age=31536000";
    default "";
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/wasm;

    include /etc/nginx/snippets/api-proxy*.conf;

    # Hashed build assets never change -> cache for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ES modules (onnxruntime loader). nginx's default mime map has no .mjs entry, and browsers
    # refuse to run a module served as application/octet-stream.
    location ~* \.mjs$ {
        types { }
        default_type application/javascript;
        expires 7d;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Model + wasm runtimes: large, rarely change.
    location ~* \.(onnx|task|wasm)$ {
        default_type application/octet-stream;
        expires 7d;
        add_header Cache-Control "public";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # SPA fallback: every unknown path is handled by React Router.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
