# Rendered by the nginx image at start-up (envsubst): ${BACKEND_URL} and ${NGINX_RESOLVER} come
# from the environment, so the backend address is configurable without rebuilding the image.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 1m;

    # Resolve the backend name at request time (docker DNS), so a restarted backend is found again.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/wasm;

    # Reverse proxy: the browser only ever talks to /api on this same origin (no CORS needed).
    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Hashed build assets never change -> cache for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ES modules (onnxruntime loader). nginx's default mime map has no .mjs entry, and browsers
    # refuse to run a module served as application/octet-stream.
    location ~* \.mjs$ {
        types { }
        default_type application/javascript;
        expires 7d;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Model + wasm runtimes: large, rarely change.
    location ~* \.(onnx|task|wasm)$ {
        default_type application/octet-stream;
        expires 7d;
        add_header Cache-Control "public";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # SPA fallback: every unknown path is handled by React Router.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
