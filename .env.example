# Rewind environment template. Copy to ".env" and fill values.
# Inside docker compose everything runs locally (frontend, backend, mongo container).

# MongoDB container. Host = the service name from docker-compose.yml ("mongo"),
# NOT localhost (inside a container localhost is the container itself).
MONGODB_URI=mongodb://mongo:27017
DB_NAME=rewind

# Secret that signs login tokens. Any long random string.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-64-char-hex-string
JWT_EXPIRE_MINUTES=60

# Comma separated list of allowed CORS origins for the raw :8000 port.
ALLOWED_ORIGINS=http://localhost:3000

# Optional AI feature (Gemini). SUBMIT EMPTY. The site works and fails politely without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
